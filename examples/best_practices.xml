<?xml version="1.0"?>
<scene>
    <!-- Camera positioned for optimal view -->
    <camera
        vrpX="10" vrpY="-6" vrpZ="6"
        vpnX="0" vpnY="0" vpnZ="0"
        vupX="0" vupY="0" vupZ="1"
        prpX="0" prpY="0" prpZ="1"
        Umin="-2" Vmin="-1.5" Umax="2" Vmax="1.5"
        front="0.5"
        back="-40"
    />
    
    <!-- High ambient lighting for better visibility -->
    <alight
        r="1" g="1" b="1" s="0.5"
    />
    
    <!-- Strong primary lights -->
    <plight
        x="6" y="-4" z="10"
        r="1" g="1" b="1" s="30"
        attX="1" attY="0.02" attZ="0.005"
    />
    
    <plight
        x="-6" y="-4" z="8"
        r="1" g="1" b="1" s="20"
        attX="1" attY="0.05" attZ="0.01"
    />
    
    <!-- Sphere with Phong shading -->
    <sphere
        x="-6" y="0" z="0"
        radius="3"
        dh="20" dv="20"
        diffR="0.8" diffG="0.3" diffB="0.2" diffS="0.8"
        specR="0.6" specG="0.6" specB="0.6" specS="0.5"
        shading="PHONG"
    />
    
    <!-- Sphere with Gouraud shading -->
    <sphere
        x="0" y="0" z="0"
        radius="3"
        dh="20" dv="20"
        diffR="0.2" diffG="0.8" diffB="0.3" diffS="0.8"
        specR="0.6" specG="0.6" specB="0.6" specS="0.5"
        shading="GOUARD"
    />
    
    <!-- Sphere with constant shading -->
    <sphere
        x="6" y="0" z="0"
        radius="3"
        dh="20" dv="20"
        diffR="0.3" diffG="0.2" diffB="0.8" diffS="0.8"
        specR="0.6" specG="0.6" specB="0.6" specS="0.5"
        shading="CONST"
    />
    
    <!-- Ground plane -->
    <block
        x="0" y="0" z="-4"
        l="20" w="12" h="0.5"
        dl="6" dw="4" dh="1"
        diffR="0.6" diffG="0.6" diffB="0.6" diffS="0.7"
        specR="0.3" specG="0.3" specB="0.3" specS="0.3"
        shading="GOUARD"
    />
</scene>
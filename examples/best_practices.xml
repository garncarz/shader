<?xml version="1.0"?>
<scene>
    <!-- Camera positioned for optimal view of multiple spheres -->
    <camera
        vrpX="20" vrpY="-5" vrpZ="15"
        vpnX="20" vpnY="-5" vpnZ="15"
        vupX="0" vupY="0" vupZ="1"
        prpX="0" prpY="0" prpZ="1"
        Umin="-1" Vmin="-1" Umax="1" Vmax="1"
        front="0.5"
        back="-60"
    />
    
    <!-- Reduced lighting intensity for better balance -->
    <alight
        r="1" g="1" b="1" s="0.4"
    />
    
    <!-- Balanced point lights -->
    <plight
        x="10" y="10" z="6"
        r="1" g="1" b="1" s="15"
        attX="1" attY="0.3" attZ="0.45"
    />
    
    <plight
        x="-10" y="-10" z="6"
        r="1" g="1" b="1" s="10"
        attX="1" attY="0.5" attZ="0.5"
    />
    
    <!-- Sphere with Phong shading (left) -->
    <sphere
        x="-10" y="0" z="0"
        radius="3"
        dh="20" dv="20"
        diffR="0.8" diffG="0.3" diffB="0.2" diffS="0.8"
        specR="0.6" specG="0.6" specB="0.6" specS="0.5"
        shading="PHONG"
    />
    
    <!-- Sphere with Gouraud shading (center) -->
    <sphere
        x="0" y="0" z="0"
        radius="3"
        dh="20" dv="20"
        diffR="0.2" diffG="0.8" diffB="0.3" diffS="0.8"
        specR="0.6" specG="0.6" specB="0.6" specS="0.5"
        shading="GOUARD"
    />
    
    <!-- Sphere with constant shading (right) -->
    <sphere
        x="10" y="0" z="0"
        radius="3"
        dh="20" dv="20"
        diffR="0.3" diffG="0.2" diffB="0.8" diffS="0.8"
        specR="0.6" specG="0.6" specB="0.6" specS="0.5"
        shading="CONST"
    />
    
    <!-- Ground plane for reference -->
    <block
        x="0" y="0" z="-4"
        l="20" w="12" h="0.5"
        dl="6" dw="4" dh="1"
        diffR="0.6" diffG="0.6" diffB="0.6" diffS="0.7"
        specR="0.3" specG="0.3" specB="0.3" specS="0.3"
        shading="GOUARD"
    />
</scene>